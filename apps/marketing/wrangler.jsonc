{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billwave-marketing",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-01-31",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },

  "services": [
    {
      "binding": "DOCS",
      "service": "billwave-docs",
    },
  ],
  "previews": {},
  "routes": [
    {
      "pattern": "billwave.digvijayrawat.me",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
