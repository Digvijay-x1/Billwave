{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billwave-dashboard",
	"main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-01-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "vars": {
    "VITE_DOCS_URL": "https://billwave.example/docs",
    "VITE_API_URL_TEST": "https://sandbox.billwave.example",
    "VITE_API_URL_LIVE": "https://api.billwave.example",
    "PUBLIC_API_URL_TEST": "https://sandbox.billwave.example",
    "PUBLIC_API_URL_LIVE": "https://api.billwave.example",
  },

  "observability": {
    "enabled": true,
  },
}
