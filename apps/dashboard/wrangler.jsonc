{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billwave-dashboard",
	"main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-01-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "app.billwave.digvijayrawat.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "vars": {
    "VITE_DOCS_URL": "https://docs.billwave.digvijayrawat.me",
    "VITE_API_URL_TEST": "https://sandbox-api.billwave.digvijayrawat.me",
    "VITE_API_URL_LIVE": "https://api.billwave.digvijayrawat.me",
    "PUBLIC_API_URL_TEST": "https://sandbox-api.billwave.digvijayrawat.me",
    "PUBLIC_API_URL_LIVE": "https://api.billwave.digvijayrawat.me",
  },

  "observability": {
    "enabled": true,
  },
}
