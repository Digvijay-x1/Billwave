{
  "name": "@digvijay-x1/billwave-cli",
  "version": "0.8.0",
  "description": "CLI for Billwave - sync catalog, manage billing infrastructure",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Digvijay-x1/Billwave",
    "directory": "packages/cli"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "billwave": "./dist/index.js",
    "bw": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@digvijay-x1/types": "workspace:*",
    "commander": "^14.0.3",
    "jiti": "^2.6.1",
    "@digvijay-x1/billwave": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
